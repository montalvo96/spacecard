# Plantilla para el servidor de producción.
# Copia este archivo como .env en el servidor y completa los valores vacíos.
# Genera APP_KEY con: docker compose run --rm app php artisan key:generate --show

APP_NAME=SpaceCard
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.com
APP_PORT=80

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Docker Compose fuerza DB_HOST=mysql y DB_PORT=3306 dentro de los contenedores.
DB_CONNECTION=mysql
DB_DATABASE=spacecard
DB_USERNAME=spacecard
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hola@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- IA: generación de Spaces con Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Apple Wallet (.pkpass) ---
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_ORG_NAME="SpaceCard"
APPLE_WALLET_CERT_PATH=
APPLE_WALLET_CERT_PASSWORD=
APPLE_WALLET_WWDR_PATH=

# --- Google Wallet ---
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_SUFFIX=spacecard_generic
GOOGLE_WALLET_SERVICE_ACCOUNT_PATH=

# --- Stripe Checkout (pagos de SpaceShop) ---
# Llaves LIVE (pk_live_ / sk_live_). El whsec_ sale del webhook registrado en el
# panel de Stripe apuntando a https://<dominio>/stripe/webhook con los eventos
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed y checkout.session.expired.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=mxn
